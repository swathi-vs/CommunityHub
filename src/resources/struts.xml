<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
    "http://struts.apache.org/dtds/struts-2.5.dtd">
<!--
  JSON API. Every action writes an ApiResponse JSON body itself and returns NONE,
  so actions declare no results. Validation errors go to the global "input" result
  and unhandled exceptions to "serverError", both of which also return JSON.
-->
<struts>
    <constant name="struts.enable.SlashesInActionNames" value="true"/>
    <package name="default" namespace="/" extends="struts-default">
        <result-types>
            <result-type name="jsonInput" class="results.JsonInputResult"/>
            <result-type name="jsonError" class="results.JsonErrorResult"/>
        </result-types>

        <interceptors>
            <interceptor name="authInterceptor" class="interceptors.AuthInterceptor"/>
            <interceptor name="capabilityInterceptor" class="interceptors.CapabilityInterceptor"/>
            <interceptor name="pathParamInterceptor" class="interceptors.PathParamInterceptor"/>
            <interceptor name="dataScopingInterceptor" class="interceptors.DataScopingInterceptor"/>

            <!-- login / signup -->
            <interceptor-stack name="publicStack">
                <interceptor-ref name="defaultStack"/>
            </interceptor-stack>

            <!-- logged in, no organization capability needed -->
            <interceptor-stack name="authStack">
                <interceptor-ref name="authInterceptor"/>
                <interceptor-ref name="defaultStack"/>
                <interceptor-ref name="pathParamInterceptor"/>
            </interceptor-stack>

            <!-- logged in + member of the URL organization + required capability -->
            <interceptor-stack name="secureStack">
                <interceptor-ref name="authInterceptor"/>
                <interceptor-ref name="capabilityInterceptor"/>
                <interceptor-ref name="defaultStack"/>
                <interceptor-ref name="pathParamInterceptor"/>
                <interceptor-ref name="dataScopingInterceptor"/>
            </interceptor-stack>
        </interceptors>

        <default-interceptor-ref name="authStack"/>

        <global-results>
            <result name="input" type="jsonInput"/>
            <result name="serverError" type="jsonError"/>
        </global-results>

        <global-exception-mappings>
            <exception-mapping exception="java.lang.Exception" result="serverError"/>
        </global-exception-mappings>

        <action name="login" class="action.LoginAction">
            <interceptor-ref name="publicStack"/>
        </action>

        <action name="signup" class="action.SignUpAction">
            <interceptor-ref name="publicStack"/>
        </action>

        <action name="auth/logout" class="action.LogoutAction">
        </action>

        <action name="auth/change-password" class="action.ChangePasswordAction">
        </action>

        <action name="roles" class="action.GetRolesAction">
        </action>

        <action name="property-types" class="action.GetPropertyTypesAction">
        </action>

        <action name="organization/create" class="action.CreateOrganizationAction">
        </action>

        <action name="organizations/*/update" class="action.UpdateOrganizationAction">
